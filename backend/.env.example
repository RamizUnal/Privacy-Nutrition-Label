# Privacy Nutrition Label – Environment Variables
# Copy this file to .env and fill in your API key

# Anthropic API key – get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Brave Search API key for privacy-policy discovery.
# Used after known policy URLs and before homepage/path/sitemap fallback.
BRAVE_SEARCH_API_KEY=

# Optional Brave Search localization.
SEARCH_COUNTRY=US
SEARCH_LANG=en

# Optional policy fetch language preference.
CRAWLER_ACCEPT_LANGUAGE=en-US,en;q=0.9,tr-TR;q=0.7,tr;q=0.6

# Optional: skip hardcoded known policy URLs and force normal discovery.
SKIP_KNOWN_POLICY_URLS=false

# Optional: use Claude to rerank Brave Search results before heuristics.
ENABLE_AI_SEARCH_RERANK=true

# Optional: use Claude to extract data categories and third-party recipients
# from the policy text. Falls back to regex/taxonomy analysis if unavailable.
ENABLE_AI_POLICY_EXTRACTION=true
AI_POLICY_EXTRACTION_MAX_CHARS=50000

# Optional: use a reader fallback for JS-rendered policy pages after direct fetch fails.
ENABLE_READER_FALLBACK=true

# Optional heavier browser crawl for tracker/consent-state analysis.
# Disabled by default so /analyze returns quickly.
ENABLE_DYNAMIC_CRAWL=false
